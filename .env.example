# 飞书群机器人 Webhook（群设置 → 机器人 → 自定义机器人）
# 与 daily_stock_analysis 相同：FEISHU_WEBHOOK_URL
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# 可选：签名校验 Secret（开启「签名校验」时填写）
FEISHU_WEBHOOK_SECRET=

# 可选：用 LLM 润色/结构化（不填则仅输出数据+规则模板）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 观察名单模式：auto=每日按涨停池规则生成 | merge=规则+下面手动码 | manual=仅手动
WATCHLIST_MODE=auto

# 可选：手动补充/覆盖（auto 模式下可留空；merge/manual 时使用）
# WATCHLIST=603028,603528,002708

# 体温计：默认 auto，按 MAINLINE_KEYWORD 主线里「空间龙」每日自动选；仅钉住某天时填
# THERMOMETER_MODE=auto
# THERMOMETER=

# 可选：观察名单角色（代码:角色,…）写入次日预案表
# WATCH_ROLES=603028:机器人龙一,603528:同梯队硬板,603278:仅体温计

# 可选：硬条件筛票时按「所属行业」包含关键字过滤（如 机器人）
# MAINLINE_KEYWORD=机器人
